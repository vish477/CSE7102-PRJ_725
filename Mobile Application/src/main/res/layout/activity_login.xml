<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="GeoSafe Login" android:textSize="28sp" android:textStyle="bold"
    android:gravity="center" android:layout_marginBottom="24dp"/>

<EditText android:id="@+id/etUsername" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:hint="Username" android:inputType="text" />
<EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:hint="Password" android:inputType="textPassword" android:layout_marginTop="16dp"/>
<Button android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Login" android:layout_marginTop="24dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Demo login: admin / 1234" android:gravity="center" android:layout_marginTop="16dp"/>

</LinearLayout>
</ScrollView>
