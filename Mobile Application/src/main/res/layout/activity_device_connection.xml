<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="🔗 Device Connection" android:textSize="30sp" android:textStyle="bold"
        android:gravity="center" android:layout_marginTop="30dp" android:layout_marginBottom="35dp"/>
    <TextView android:id="@+id/txtDeviceStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Device Status: Not Connected" android:textSize="20sp" android:gravity="center"
        android:layout_marginBottom="25dp"/>
    <Button android:id="@+id/btnConnectDevice" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Connect / Scan ESP32" android:textSize="18sp"/>
    <Button android:id="@+id/btnStartMonitoring" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Start Background Monitoring" android:textSize="18sp" android:layout_marginTop="15dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="ESP32 → BLE → GeoSafe\nMAX30100 Heart Rate + NEO-6M GPS"
        android:textSize="18sp" android:gravity="center" android:layout_marginTop="35dp"/>
</LinearLayout>